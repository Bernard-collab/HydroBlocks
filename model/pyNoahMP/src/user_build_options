#=============================================================================================
#  Options for Linux with gfortran (not fully tested)
#=============================================================================================

 COMPILERF90    = /projects/battobrah@xsede.org/software/anaconda/envs/HB/bin/gfortran
FREESOURCE     = -ffree-form -ffree-line-length-none -cpp
F90FLAGS       = -g -fconvert=big-endian -O3 -fbounds-check -fbacktrace -fPIC -fallow-argument-mismatch
MODFLAG        = -I
CPP            = /projects/battobrah@xsede.org/software/anaconda/envs/HB/bin/cpp
CPPFLAGS       = -P -traditional
LIBS           = -fopenmp
LIBJASPER      = -ljpeg -ljasper
NETCDFMOD      = /projects/battobrah@xsede.org/software/anaconda/envs/HB/include/
NETCDFLIB      = -lnetcdf
BZIP2          = YES
BZIP2_LIB      = -lbz2
BZIP2_INCLUDE  = -I/projects/battobrah@xsede.org/software/anaconda/envs/HB/include/
RM             = rm -f
CC             = /projects/battobrah@xsede.org/software/anaconda/envs/HB/bin/cpp


